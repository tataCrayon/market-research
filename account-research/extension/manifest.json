{
  "manifest_version": 3,
  "name": "小红书对标采集",
  "version": "7.2.1",
  "description": "把当前窗口里已打开的小红书笔记页各存一份单文件 MHTML（含图）并直接入库。不发请求、不导航、不开新页。",
  "key": "",
  "permissions": ["scripting", "pageCapture", "nativeMessaging"],
  "host_permissions": ["https://www.xiaohongshu.com/*"],
  "action": {
    "default_title": "小红书对标采集：把已打开的笔记页存成 MHTML 并入库",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
