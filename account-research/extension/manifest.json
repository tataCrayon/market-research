{
  "manifest_version": 3,
  "name": "AR 采集（account-research）",
  "version": "2.0.0",
  "description": "点一下，把当前窗口里所有已打开的小红书笔记页各存一个 txt。不发请求、不导航、不开新页。",
  "permissions": ["scripting", "downloads"],
  "host_permissions": ["https://www.xiaohongshu.com/*"],
  "action": {
    "default_title": "AR 采集：批量保存当前窗口里所有小红书笔记页",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
