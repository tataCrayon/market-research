{
  "manifest_version": 3,
  "name": "AR 采集（account-research）",
  "version": "1.0.0",
  "description": "在当前已打开的小红书笔记页读已渲染文字，存成 ar-note-<id>.txt 到本机。零网络请求。",
  "permissions": ["activeTab", "scripting", "downloads"],
  "action": {
    "default_title": "AR 采集：读当前页 → 存 txt",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
